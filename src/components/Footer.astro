---
import { pageLocale } from '../i18n';
import { localePath } from '../i18n/locales';
import { EMAIL, LABS, REPO } from '../site';

const { t, href, health } = pageLocale(Astro.url);
---

<footer class="wrap">
  <p class="note">{t.footer.disclaimer}</p>
  <div class="foot">
    <p>&copy; {new Date().getFullYear()} <a href={LABS}>Manyx Labs</a>, {t.footer.place}</p>
    <nav aria-label={t.footer.nav}>
      <a href={localePath(health, '/exercises/')}>{t.footer.exercises}</a>
      <a href={href('/privacy/')}>{t.footer.privacy}</a>
      <a href={REPO} target="_blank" rel="noopener">{t.footer.source}</a>
      <a href={`${REPO}/issues/new`} target="_blank" rel="noopener">{t.footer.issue}</a>
      <a href={`mailto:${EMAIL}`}>{t.footer.email}</a>
    </nav>
  </div>
</footer>

<style>
  .note {
    padding-top: 32px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    justify-content: space-between;
    padding-block: 16px 40px;
    color: var(--muted);
    font-size: 0.875rem;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }

  a {
    text-decoration: none;
  }

  a:hover {
    color: var(--text);
  }
</style>
