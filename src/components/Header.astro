---
import { pageLocale } from '../i18n';
import { appHref, LANG_KEY, LOCALES, localePath, NAMES, type Locale } from '../i18n/locales';
import { healthLocale } from '../i18n/review';
import { markSvg } from '../mark';

type Props = { locales?: readonly Locale[] };
const { locales = LOCALES } = Astro.props;
const { locale, path, t, href } = pageLocale(Astro.url);
// A page not yet published in a language (one waiting for its health review) leads to that language's home.
const target = (l: Locale) => localePath(l, locales.includes(l) ? path : '/');
// Guides are health advice, published in a language only once reviewed; until then the English ones.
const guidesHref = localePath(healthLocale(locale), '/guides/');
---

<div class="progress" aria-hidden="true"></div>
<header class="top">
  <div class="wrap">
    <div class="bar glass">
      <a href={href('/')} class="brand" aria-label={t.header.home}>
        <Fragment set:html={markSvg({ ink: 'currentColor', accent: 'rgb(var(--accent))', size: 28, pad: -2 })} />
        Fit
      </a>
      <nav aria-label={t.header.nav}>
        <a class="link wide" href={href('/calculators/')}>{t.header.calculators}</a>
        <a class="link wide" href={guidesHref}>{t.header.guides}</a>
        <a class="link" href={appHref(locale)}>{t.header.openApp}</a>
        <details class="lang" data-key={LANG_KEY}>
          <summary aria-label={`${t.language}: ${NAMES[locale]}`}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path>
            </svg>
            <span class="current">{NAMES[locale]}</span>
          </summary>
          <ul class="glass menu">
            {
              LOCALES.map((l) => (
                <li>
                  <a href={target(l)} lang={l} hreflang={l} aria-current={l === locale ? 'true' : undefined}>
                    {NAMES[l]}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
        <button class="theme" type="button" aria-label={t.header.theme} data-to-light={t.header.toLight} data-to-dark={t.header.toDark}>
          <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>
          <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z"></path>
          </svg>
        </button>
      </nav>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('.theme')!;
  const label = () => button.setAttribute('aria-label', root.classList.contains('dark') ? button.dataset.toLight! : button.dataset.toDark!);
  label();
  // After the listener in <head>, which follows the system theme while none is saved.
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', label);
  button.addEventListener('click', () => {
    const dark = root.classList.toggle('dark');
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {}
    label();
  });

  const bar = document.querySelector<HTMLElement>('.progress')!;
  const progress = () => {
    const max = root.scrollHeight - innerHeight;
    bar.style.scale = `${max > 0 ? scrollY / max : 0} 1`;
  };
  progress();
  addEventListener('scroll', progress, { passive: true });
  addEventListener('resize', progress);

  // A <details> menu opens and closes from the keyboard by itself; this closes it the way menus do.
  const menu = document.querySelector<HTMLDetailsElement>('.lang')!;
  for (const a of menu.querySelectorAll('a'))
    a.addEventListener('click', () => {
      // So the app, at one address for every language, opens in the one picked here.
      try {
        localStorage.setItem(menu.dataset.key!, a.lang);
      } catch {}
    });
  document.addEventListener('click', (e) => {
    if (!menu.contains(e.target as Node)) menu.open = false;
  });
  menu.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || !menu.open) return;
    menu.open = false;
    menu.querySelector('summary')!.focus();
  });
</script>

<style>
  /* The portfolio's Navbar: a floating glass pill, fixed 16px from the top. */
  .top {
    position: fixed;
    inset: 16px 0 auto;
    z-index: 50;
  }

  /* Space for the fixed bar, so it never covers the page's first line. */
  :global(body:has(> .top)) {
    padding-top: 88px;
  }

  .wrap {
    max-width: 64rem;
    padding-inline: 16px;
  }

  .progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    height: 2px;
    background: rgb(var(--accent));
    scale: 0 1;
    transform-origin: left;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 8px 8px 20px;
    border-radius: 999px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    text-decoration: none;
    white-space: nowrap;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .link {
    padding: 8px 16px;
    border-radius: 999px;
    color: rgb(var(--muted));
    font-size: 0.875rem;
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 0.2s,
      background-color 0.2s;
  }

  .link:hover {
    background: rgb(var(--fg) / 0.05);
    color: rgb(var(--fg));
  }

  @media (max-width: 479px) {
    .link {
      padding-inline: 10px;
    }
  }

  /* The narrowest phones drop it; the logo and the hero's button both lead there. */
  @media (max-width: 419px) {
    .wide {
      display: none;
    }
  }

  /* The portfolio's theme button: a borderless round icon, tinted on hover. */
  .theme,
  .lang summary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: none;
    color: rgb(var(--fg));
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .theme:hover,
  .lang summary:hover,
  .lang[open] summary {
    background: rgb(var(--fg) / 0.1);
  }

  :is(.theme, .lang) svg {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The icon shows the theme a click switches to. */
  .sun,
  :global(.dark) .moon {
    display: none;
  }

  :global(.dark) .sun {
    display: block;
  }

  .lang {
    position: relative;
  }

  .lang summary {
    padding-inline: 10px;
    list-style: none;
  }

  .lang summary::-webkit-details-marker {
    display: none;
  }

  .current {
    color: rgb(var(--muted));
  }

  @media (max-width: 479px) {
    .lang summary {
      padding-inline: 0;
    }

    .current {
      display: none;
    }
  }

  .menu {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    display: grid;
    margin: 0;
    padding: 8px;
    border-radius: 24px;
    list-style: none;
    /* Inside the bar's glass, which becomes its backdrop root, so a blur here would see nothing of the page. */
    background: rgb(var(--ink));
  }

  .menu a {
    display: block;
    padding: 8px 16px;
    border-radius: 16px;
    color: rgb(var(--muted));
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 0.2s,
      background-color 0.2s;
  }

  .menu a:hover {
    background: rgb(var(--fg) / 0.05);
    color: rgb(var(--fg));
  }

  .menu a[aria-current] {
    color: rgb(var(--fg));
    font-weight: 600;
  }
</style>
