---
import { pageLocale } from '../i18n';
import { appHref, LANG_KEY, LOCALES, localePath, NAMES, type Locale } from '../i18n/locales';
import { healthLocale } from '../i18n/review';
import { markSvg } from '../mark';

type Props = { locales?: readonly Locale[] };
const { locales = LOCALES } = Astro.props;
const { locale, path, t, href } = pageLocale(Astro.url);
// A page not yet published in a language (one waiting for its health review) leads to that language's home.
const target = (l: Locale) => localePath(l, locales.includes(l) ? path : '/');
// Guides are health advice, published in a language only once reviewed; until then the English ones.
const guidesHref = localePath(healthLocale(locale), '/guides/');
const links = [
  [href('/calculators/'), t.header.calculators],
  [guidesHref, t.header.guides],
] as const;
---

<div class="progress" aria-hidden="true"></div>
<header class="top">
  <div class="wrap">
    <div class="bar glass">
      <a href={href('/')} class="brand" aria-label={t.header.home}>
        <Fragment set:html={markSvg({ ink: 'currentColor', accent: 'rgb(var(--accent))', size: 28, pad: -2 })} />
        Fit
      </a>
      <nav aria-label={t.header.nav}>
        {links.map(([to, name]) => <a class="link" href={to}>{name}</a>)}
        <a class="link" href={appHref(locale)}>{t.header.openApp}</a>
        <details class="pop lang" data-key={LANG_KEY}>
          <summary aria-label={`${t.language}: ${NAMES[locale]}`}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path>
            </svg>
            <span class="current">{NAMES[locale]}</span>
          </summary>
          <ul class="glass menu">
            {
              LOCALES.map((l) => (
                <li>
                  <a href={target(l)} lang={l} hreflang={l} aria-current={l === locale ? 'true' : undefined}>
                    {NAMES[l]}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
        <button class="theme" type="button" aria-label={t.header.theme} data-to-light={t.header.toLight} data-to-dark={t.header.toDark}>
          <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>
          <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z"></path>
          </svg>
        </button>
        <!-- The portfolio's phone menu: below 768px the text links, too wide in some scripts, move here. -->
        <details class="pop more">
          <summary aria-label={t.header.menu}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
          </summary>
          <div class="glass sheet">
            {links.map(([to, name]) => <a href={to}>{name}</a>)}
            <a class="btn primary" href={appHref(locale)}>{t.header.openApp}</a>
          </div>
        </details>
      </nav>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('.theme')!;
  const label = () => button.setAttribute('aria-label', root.classList.contains('dark') ? button.dataset.toLight! : button.dataset.toDark!);
  label();
  // After the listener in <head>, which follows the system theme while none is saved.
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', label);
  button.addEventListener('click', () => {
    const dark = root.classList.toggle('dark');
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {}
    label();
  });

  const bar = document.querySelector<HTMLElement>('.progress')!;
  const progress = () => {
    const max = root.scrollHeight - innerHeight;
    bar.style.scale = `${max > 0 ? scrollY / max : 0} 1`;
  };
  progress();
  addEventListener('scroll', progress, { passive: true });
  addEventListener('resize', progress);

  const lang = document.querySelector<HTMLDetailsElement>('.lang')!;
  for (const a of lang.querySelectorAll('a'))
    a.addEventListener('click', () => {
      // So the app, at one address for every language, opens in the one picked here.
      try {
        localStorage.setItem(lang.dataset.key!, a.lang);
      } catch {}
    });

  // A <details> menu opens and closes from the keyboard by itself; this closes it the way menus do,
  // and keeps only one open.
  const pops = [...document.querySelectorAll<HTMLDetailsElement>('.pop')];
  for (const pop of pops) {
    pop.addEventListener('toggle', () => {
      if (pop.open) for (const other of pops) if (other !== pop) other.open = false;
    });
    pop.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !pop.open) return;
      pop.open = false;
      pop.querySelector('summary')!.focus();
    });
  }
  document.addEventListener('click', (e) => {
    for (const pop of pops) if (!pop.contains(e.target as Node)) pop.open = false;
  });
</script>

<style>
  /* The portfolio's Navbar: a floating glass pill, fixed 16px from the top. */
  .top {
    position: fixed;
    inset: 16px 0 auto;
    z-index: 50;
  }

  /* Space for the fixed bar, so it never covers the page's first line. */
  :global(body:has(> .top)) {
    padding-top: 88px;
  }

  .wrap {
    max-width: 64rem;
    padding-inline: 16px;
  }

  .progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    height: 2px;
    background: rgb(var(--accent));
    scale: 0 1;
    transform-origin: left;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 8px 8px 20px;
    border-radius: 999px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    text-decoration: none;
    white-space: nowrap;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .link {
    padding: 8px 16px;
    border-radius: 999px;
    color: rgb(var(--muted));
    font-size: 0.875rem;
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 0.2s,
      background-color 0.2s;
  }

  .link:hover {
    background: rgb(var(--fg) / 0.05);
    color: rgb(var(--fg));
  }

  /* Every language's links fit beside the controls from 768px; below, they are in the menu. */
  @media (max-width: 767px) {
    .link {
      display: none;
    }
  }

  @media (min-width: 768px) {
    .more {
      display: none;
    }
  }

  /* The portfolio's theme button: a borderless round icon, tinted on hover. */
  .theme,
  .pop summary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: none;
    color: rgb(var(--fg));
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .theme:hover,
  .pop summary:hover,
  .pop[open] summary {
    background: rgb(var(--fg) / 0.1);
  }

  :is(.theme, .pop) svg {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The icon shows the theme a click switches to. */
  .sun,
  :global(.dark) .moon {
    display: none;
  }

  :global(.dark) .sun {
    display: block;
  }

  .lang {
    position: relative;
  }

  .lang summary {
    padding-inline: 10px;
  }

  .pop summary {
    list-style: none;
  }

  .pop summary::-webkit-details-marker {
    display: none;
  }

  .current {
    color: rgb(var(--muted));
  }

  @media (max-width: 479px) {
    .lang summary {
      padding-inline: 0;
    }

    .current {
      display: none;
    }
  }

  .menu {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    display: grid;
    margin: 0;
    padding: 8px;
    border-radius: 24px;
    list-style: none;
    /* Inside the bar's glass, which becomes its backdrop root, so a blur here would see nothing of the page. */
    background: rgb(var(--ink));
  }

  .menu a {
    display: block;
    padding: 8px 16px;
    border-radius: 16px;
    color: rgb(var(--muted));
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 0.2s,
      background-color 0.2s;
  }

  .menu a:hover {
    background: rgb(var(--fg) / 0.05);
    color: rgb(var(--fg));
  }

  .menu a[aria-current] {
    color: rgb(var(--fg));
    font-weight: 600;
  }

  /* Under the whole bar, as the portfolio's phone menu sits under its pill; .bar is its containing block. */
  .sheet {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    left: 0;
    display: grid;
    padding: 8px;
    border-radius: 24px;
    /* Inside the bar's glass, like the language list, so it needs its own ground. */
    background: rgb(var(--ink));
  }

  .sheet a:not(.btn) {
    padding: 12px 16px;
    border-radius: 16px;
    color: rgb(var(--muted));
    text-decoration: none;
    transition:
      color 0.2s,
      background-color 0.2s;
  }

  .sheet a:not(.btn):hover {
    background: rgb(var(--fg) / 0.05);
    color: rgb(var(--fg));
  }

  .sheet .btn {
    margin-top: 8px;
  }
</style>
