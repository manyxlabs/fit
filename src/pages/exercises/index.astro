---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { EXERCISES, exerciseSlug, MUSCLES, type ExerciseId, type Muscle } from '../../data/exercises';
import '../../styles/pages.css';

const ids = Object.keys(EXERCISES) as ExerciseId[];
const groups = (Object.keys(MUSCLES) as Muscle[]).map((m) => [m, ids.filter((id) => EXERCISES[id].primary[0] === m)] as const).filter(([, list]) => list.length);
---

<Base title="Exercise guides" description={`How to do ${ids.length} gym, home and bodyweight exercises: muscles worked, step-by-step form, common mistakes, sets and reps, and swaps.`}>
  <Header />
  <main class="wrap page">
    <h1>Exercise guides</h1>
    <p class="lede">Step-by-step form, the muscles each one works, common mistakes and what to swap it for, grouped by the main muscle.</p>
    <div class="ex-groups">
      {
        groups.map(([m, list]) => (
          <section>
            <h2>{MUSCLES[m]}</h2>
            <ul class="links">
              {list.map((id) => (
                <li>
                  <a href={`/exercises/${exerciseSlug(id)}/`}>{EXERCISES[id].name}</a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </main>
  <Footer />
</Base>
