---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { CALCULATORS } from '../../calcs/list';
import '../../styles/pages.css';
---

<Base og="calculators" title="Free fitness calculators" description="BMI, TDEE, macros, protein, body fat, one-rep max, heart-rate zones, water and calories burned, free and private.">
  <Header />
  <main class="wrap page">
    <h1>Fitness calculators</h1>
    <p class="lede">Free, instant and private: everything is worked out in your browser.</p>
    <ul class="tiles">
      {
        CALCULATORS.map((c) => (
          <li>
            <a class="tile glass" href={`/calculators/${c.slug}/`}>
              <strong>{c.name}</strong>
              <span>{c.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
  <Footer />
</Base>
