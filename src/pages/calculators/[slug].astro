---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Calc from '../../calcs/Calculators';
import { CALCULATORS } from '../../calcs/list';
import { guideTitle } from '../../guides';
import '../../styles/pages.css';

export const getStaticPaths = () => CALCULATORS.map((c) => ({ params: { slug: c.slug }, props: { c } }));
const { c } = Astro.props;
const others = CALCULATORS.filter((o) => o.slug !== c.slug);
---

<Base og={`calculator-${c.slug}`} title={c.title} description={c.description} schema={[{ '@type': 'WebApplication', name: c.title, applicationCategory: 'HealthApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' } }]}>
  <Header />
  <main class="wrap page">
    <p class="crumbs"><a href="/calculators/">Calculators</a></p>
    <h1>{c.title}</h1>
    <p class="lede">{c.description}</p>
    <Calc client:load name={c.component} />
    <section class="prose">
      <h2>How it works</h2>
      {c.how.map((s) => <p>{s}</p>)}
      <p>Read more: <a href={`/guides/${c.guide}/`}>{guideTitle(c.guide)}</a>.</p>
    </section>
    <section class="cta glass">
      <div>
        <h2>Track it every day, free</h2>
        <p>The Fit app turns these numbers into a daily plan for food, training and recovery, and adjusts them as you go. No account, and only you can read your data.</p>
      </div>
      <a class="btn primary" href="/app/">Open the app</a>
    </section>
    <nav class="more-links" aria-label="Other calculators">
      <h2>Other calculators</h2>
      <ul>{others.map((o) => <li><a href={`/calculators/${o.slug}/`}>{o.name}</a></li>)}</ul>
    </nav>
  </main>
  <Footer />
</Base>
