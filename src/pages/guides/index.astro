---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { GUIDES } from '../../guides';
import '../../styles/pages.css';
---

<Base title="Fitness guides" description="Plain guides to building muscle, losing fat, Indian diets for fitness, supplements, sleep, cardio and training when sick or tired.">
  <Header />
  <main class="wrap page">
    <h1>Guides</h1>
    <p class="lede">Evidence-based, practical and written for Indian kitchens, veg and non-veg.</p>
    <ul class="tiles">
      {
        GUIDES.map((g) => (
          <li>
            <a class="tile glass" href={`/guides/${g.slug}/`}>
              <strong>{g.title}</strong>
              <span>{g.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
  <Footer />
</Base>
